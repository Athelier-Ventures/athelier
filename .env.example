# Configuración pública (Firebase Web). Utilizar los datos de athelier-ventures.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=athelier-ventures.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=athelier-ventures
NEXT_PUBLIC_FIREBASE_APP_ID=

# Configuración PRIVADA (Vercel, nunca NEXT_PUBLIC ni GitHub). No compartir claves en chats.
FIREBASE_PROJECT_ID=athelier-ventures
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ATHELIER_ADMIN_EMAILS=
# Establecer a "true" SOLO DESPUÉS de publicar las reglas firestore.rules
ATHELIER_FIRESTORE_RULES_CONFIRMED=false
